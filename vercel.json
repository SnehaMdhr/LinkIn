{
    "installCommand": "cd frontend && npm install && cd ../backend && npm install",
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/dist",
    "builds": [
        {
            "src": "backend/api/index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "backend/api/index.js"
        }
    ]
}