{
    "installCommand": "npm install --prefix frontend && npm install --prefix backend",
    "buildCommand": "npm run build --prefix frontend",
    "outputDirectory": "frontend/dist",
    "builds": [
        {
            "src": "backend/api/index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "backend/api/index.js"
        }
    ]
}
